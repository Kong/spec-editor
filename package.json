{
  "author": {
    "name": "Kong Inc.",
    "url": "https://konghq.com/"
  },
  "config": {
    "commitizen": {
      "jiraAppend": "]",
      "jiraLocation": "post-description",
      "jiraOptional": true,
      "jiraPrepend": "[",
      "path": "./node_modules/@digitalroute/cz-conventional-changelog-for-jira",
      "skipScope": false
    }
  },
  "dependencies": {
    "@kong-ui-public/split-pane": "^0.3.27",
    "@kong/icons": "^1.48.0",
    "@kong/kongponents": "^9.64.7",
    "@kong/spec-renderer": "^1.113.3",
    "@stoplight/spectral-core": "^1.23.1",
    "@stoplight/spectral-ruleset-bundler": "^1.7.0",
    "@vueuse/core": "^14.4.0",
    "vue": "^3.5.38"
  },
  "description": "Live editor for Kong's open-source spec renderer",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@digitalroute/cz-conventional-changelog-for-jira": "^8.0.1",
    "@evilmartians/lefthook": "^2.1.9",
    "@kong/design-tokens": "^2.0.1",
    "@kong/eslint-config-kong-ui": "1.7.1",
    "@kong/stylelint-plugin-design-tokens": "^1.0.1",
    "@shikijs/monaco": "^4.4.3",
    "@stoplight/types": "^14.1.1",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@types/node": "^25.9.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.2",
    "monaco-editor": "^0.55.1",
    "npm-run-all2": "^8.0.4",
    "sass": "^1.102.0",
    "sass-embedded": "^1.100.0",
    "shiki": "^4.4.3",
    "stylelint": "^17.13.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-order": "^8.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.5"
  },
  "name": "@kong/spec-editor",
  "private": true,
  "scripts": {
    "build": "run-p typecheck \"build-only {@}\" --",
    "build-only": "vite build",
    "commit": "cz",
    "dev": "vite",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "preview": "vite preview",
    "stylelint": "stylelint --allow-empty-input './src/**/*.{css,scss,vue}'",
    "stylelint:fix": "stylelint --allow-empty-input './src/**/*.{css,scss,sass,vue}' --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "vue-tsc -p './tsconfig.json' --noEmit"
  },
  "type": "module",
  "version": "0.0.0",
  "volta": {
    "node": "24.18.1",
    "pnpm": "11.5.3"
  },
  "packageManager": "pnpm@11.5.3"
}
